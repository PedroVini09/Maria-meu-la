<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Painel Admin</title>

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

<body class="admin-body">

    <div class="admin-layout">

        <aside class="admin-sidebar">
            <div class="admin-logo">
                <h2>Pastoral da Juventude</h2>
                <p>Painel Administrativo</p>
            </div>

            <nav class="admin-menu">
                <a asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>

                <!--Submenu de Inscrições-->
                @{
                    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();

                    // SUBMENU INSCRIÇÕES
                    var inscricoesAberto =
                        actionAtual == "Inscricoes" ||
                        actionAtual == "NovaInscricao" ||
                        actionAtual == "EditarInscricao" ||
                        actionAtual == "DetalhesInscricao" ||
                        actionAtual == "ControleInscricoes" ||
                        actionAtual == "ExportarInscricoes";


                    // SUBMENU MISSÕES
                    var missoesAberto =
                        actionAtual == "GerenciarMissoes" ||
                        actionAtual == "NovaMissao" ||
                        actionAtual == "EditarMissao" ||
                        actionAtual == "HistoriaMissoes";
                }

                <div class="admin-nav-grupo">

                    <button type="button" class="admin-nav-toggle @(inscricoesAberto ? "aberto" : "")"
                            data-submenu="submenuInscricoes">

                        <span>
                            <i class="fa-solid fa-file-pen"></i>
                            Inscrições
                        </span>

                        <i class="fa-solid fa-chevron-down admin-nav-seta"></i>

                    </button>


                    <div id="submenuInscricoes" class="admin-submenu @(inscricoesAberto ? "aberto" : "")">

                        <a asp-controller="Admin" asp-action="Inscricoes" class="admin-submenu-link @(actionAtual == "Inscricoes" ||
                                                                 actionAtual == "NovaInscricao" ||
                                                                 actionAtual == "EditarInscricao" ||
                                                                 actionAtual == "DetalhesInscricao"
                                                                 ? "active" : "")">

                            <i class="fa-solid fa-list"></i>
                            Listar Inscrições

                        </a>


                        <a asp-controller="Admin" asp-action="ControleInscricoes" class="admin-submenu-link @(actionAtual == "ControleInscricoes" ||
                                                                 actionAtual == "NovaMissao"
                                                                 ? "active" : "")">

                            <i class="fa-solid fa-sliders"></i>
                            Ativação de Inscrições

                        </a>


                        <a asp-controller="Admin" asp-action="ExportarInscricoes" class="admin-submenu-link @(actionAtual == "ExportarInscricoes"
                                                                 ? "active" : "")">

                            <i class="fa-solid fa-file-excel"></i>
                            Exportação

                        </a>

                    </div>

                </div>
                <!-- SUBMENU DE MISSÕES -->

                <div class="admin-nav-grupo">

                    <button type="button" class="admin-nav-toggle @(missoesAberto ? "aberto" : "")"
                            data-submenu="submenuMissoes">

                        <span>
                            <i class="fa-solid fa-church"></i>
                            Missões
                        </span>

                        <i class="fa-solid fa-chevron-down admin-nav-seta"></i>

                    </button>


                    <div id="submenuMissoes" class="admin-submenu @(missoesAberto ? "aberto" : "")">


                        <!-- GERENCIAR MISSÕES -->

                        <a asp-controller="Admin" asp-action="GerenciarMissoes" class="admin-submenu-link
                            @(actionAtual == "GerenciarMissoes" ||
                             actionAtual == "EditarMissao"
                             ? "active" : "")">

                            <i class="fa-solid fa-list-check"></i>

                            Gerenciar Missões

                        </a>


                        <!-- NOVA MISSÃO -->

                        <a asp-controller="Admin" asp-action="NovaMissao" class="admin-submenu-link
                            @(actionAtual == "NovaMissao"
                             ? "active" : "")">

                            <i class="fa-solid fa-plus"></i>

                            Nova Missão

                        </a>


                        <!-- HISTÓRIA -->

                        <a asp-controller="Admin" asp-action="HistoriaMissoes" class="admin-submenu-link
                            @(actionAtual == "HistoriaMissoes"
                             ? "active" : "")">

                            <i class="fa-solid fa-book-open"></i>

                            História das Missões

                        </a>

                    </div>

                </div>
                
                <a asp-controller="Admin" asp-action="Programacoes">
                    <i class="fa-solid fa-calendar-days"></i>
                    <span>Programação</span>
                </a>

                <a asp-controller="Admin" asp-action="Noticias">
                    <i class="fa-solid fa-newspaper"></i>
                    <span>Notícias</span>
                </a>

                <a asp-controller="Admin" asp-action="Galeria">
                    <i class="fa-solid fa-image"></i>
                    <span>Galeria</span>
                </a>

                <a asp-controller="Admin" asp-action="Usuarios">
                    <i class="fa-solid fa-users"></i>
                    <span>Usuários</span>
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-logout-btn">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Sair
                    </button>
                </form>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <h1>@ViewData["Title"]</h1>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            document.querySelectorAll(".admin-nav-toggle")
                .forEach(botao => {

                    botao.addEventListener("click", () => {

                        const submenuId =
                            botao.dataset.submenu;

                        const submenu =
                            document.getElementById(submenuId);

                        if (!submenu) {
                            return;
                        }

                        const aberto =
                            submenu.classList.toggle("aberto");

                        botao.classList.toggle(
                            "aberto",
                            aberto
                        );

                    });

                });
    </script>
</body>

</html>