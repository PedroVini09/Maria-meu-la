@{
    ViewData["Title"] = "Dashboard";
}

<div class="admin-page-title">
    <h2>Dashboard</h2>
    <p>Bem-vindo ao painel administrativo da Pastoral da Juventude.</p>
</div>

<div class="admin-cards">
    <div class="admin-card">
        <h3>Inscrições</h3>
        <strong>@ViewBag.TotalInscricoes</strong>
    </div>

    <div class="admin-card">
        <h3>Programações</h3>
        <strong>@ViewBag.TotalProgramacoes</strong>
    </div>

    <div class="admin-card">
        <h3>Notícias</h3>
        <strong>@ViewBag.TotalNoticias</strong>
    </div>

    <div class="admin-card">
        <h3>Galeria</h3>
        <strong>@ViewBag.TotalGaleria</strong>
    </div>
</div>