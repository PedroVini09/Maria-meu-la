@model MariaEmMeuLar.Models.ViewModels.NovaSecaoMissaoViewModel

@{
    ViewData["Title"] = "Nova Seção";
}


<div class="admin-page-title">

    <div>

        <h2>Nova Seção</h2>

        <p>
            Cadastre uma nova seção para
            <strong>@Model.MissaoNome</strong>.
        </p>

    </div>

</div>


<div class="admin-form-card">

    <form asp-controller="Admin" asp-action="NovaSecaoMissao" method="post">

        @Html.AntiForgeryToken()


        <input asp-for="MissaoId" type="hidden" />


        <div asp-validation-summary="ModelOnly" class="login-validacao">
        </div>


        <div class="admin-form-secao">

            <h3>
                <i class="fa-solid fa-layer-group"></i>
                Informações da seção
            </h3>


            <div class="admin-form-campo">

                <label asp-for="Topico">
                    Tópico
                </label>

                <input asp-for="Topico" placeholder="Ex: O que é?" />

                <span asp-validation-for="Topico" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-campo">

                <label asp-for="Titulo">
                    Título
                </label>

                <input asp-for="Titulo" placeholder="Ex: O que é a missão Maria em Meu Lar?" />

                <span asp-validation-for="Titulo" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-campo">

                <label asp-for="Chave">
                    Chave
                </label>

                <input asp-for="Chave" placeholder="Ex: o-que-e" />

                <small>
                    Identificador interno da seção.
                    Use letras minúsculas e hífens.
                </small>

                <span asp-validation-for="Chave" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-campo">

                <label asp-for="Tipo">
                    Tipo da seção
                </label>

                <select asp-for="Tipo">

                    <option value="texto">
                        Texto
                    </option>

                    <option value="texto_imagem">
                        Texto + imagem
                    </option>

                    <option value="passos">
                        Passos
                    </option>

                    <option value="cards">
                        Cards
                    </option>

                    <option value="informacoes">
                        Informações
                    </option>

                    <option value="frase">
                        Frase
                    </option>

                    <option value="cta">
                        Chamada / CTA
                    </option>

                </select>

                <span asp-validation-for="Tipo" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-campo">

                <label asp-for="Conteudo">
                    Conteúdo
                </label>

                <textarea asp-for="Conteudo" rows="10" placeholder="Digite o conteúdo principal da seção..."></textarea>

                <span asp-validation-for="Conteudo" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-campo">

                <label asp-for="Imagem">
                    Imagem
                </label>

                <input asp-for="Imagem" placeholder="Ex: maria-importancia.png" />

                <small>
                    Por enquanto informe apenas o nome do arquivo.
                </small>

                <span asp-validation-for="Imagem" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-campo">

                <label asp-for="Ordem">
                    Ordem de exibição
                </label>

                <input asp-for="Ordem" type="number" min="0" max="100" />

                <span asp-validation-for="Ordem" class="login-validacao">
                </span>

            </div>


            <div class="admin-form-checkbox">

                <input asp-for="Ativa" />

                <label asp-for="Ativa">
                    Seção ativa
                </label>

            </div>

        </div>


        <div class="admin-form-acoes">

            <a asp-controller="Admin" asp-action="ConteudoMissao" asp-route-id="@Model.MissaoId"
               class="admin-btn-cancelar">

                <i class="fa-solid fa-arrow-left"></i>
                Cancelar

            </a>


            <button type="submit" class="admin-btn-salvar">

                <i class="fa-solid fa-floppy-disk"></i>
                Salvar Seção

            </button>

        </div>

    </form>

</div>