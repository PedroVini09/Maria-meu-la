@model MariaEmMeuLar.Models.ViewModels.EditarInscricaoViewModel

@{
    ViewData["Title"] = "Editar Inscrição";
}

<div class="admin-page-title">
    <h2>Editar Inscrição</h2>
    <p>@Model.MissaoNome</p>
</div>

<div class="admin-form-card">

    <form asp-controller="Admin" asp-action="EditarInscricao" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="login-validacao">
        </div>

        <!-- CAMPOS GERAIS -->
        <div class="admin-form-secao">
            <h3><i class="fa-solid fa-user"></i>Dados Gerais</h3>
            <div class="admin-form-grid">

                <div class="admin-form-campo">
                    <label asp-for="Nome">Nome</label>

                    <input asp-for="Nome" />

                    <span asp-validation-for="Nome" class="login-validacao"></span>
                </div>

                <div class="admin-form-campo">
                    <label asp-for="Telefone">Telefone</label>

                    <input asp-for="Telefone" />

                    <span asp-validation-for="Telefone" class="login-validacao"></span>
                </div>

                @if (Model.Idade.HasValue ||
                     Model.MissaoNome == "Retiro Quaresmal" ||
                     Model.MissaoNome == "Semana da Juventude" ||
                     Model.MissaoNome == "Segue-me Jovem")
                {
                    <div class="admin-form-campo">
                        <label asp-for="Idade">Idade</label>

                        <input asp-for="Idade" type="number" min="10" max="100" />

                        <span asp-validation-for="Idade" class="login-validacao"></span>
                    </div>
                }

                <div class="admin-form-campo">
                    <label asp-for="Status">Status</label>

                    <select asp-for="Status">
                        <option value="Pendente">Pendente</option>
                        <option value="Em análise">Em análise</option>
                        <option value="Confirmada">Confirmada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>

                    <span asp-validation-for="Status" class="login-validacao"></span>
                </div>

            </div>
        </div>


        <!-- MARIA -->
        @if (Model.MissaoNome == "Maria em Meu Lar")
        {
            <div class="admin-form-secao">

                <h3> <i class="fa-solid fa-house"></i>Dados da visita</h3>

                <div class="admin-form-grid">

                    <div class="admin-form-campo admin-form-full">
                        <label asp-for="Endereco">
                            Endereço
                        </label>

                        <input asp-for="Endereco" />
                        <span asp-validation-for="Endereco" class="login-validacao"></span>
                    </div>


                    <div class="admin-form-campo">
                        <label asp-for="DataDesejada">
                            Data desejada
                        </label>

                        <input asp-for="DataDesejada" type="date" />
                    </div>


                    <div class="admin-form-campo">
                        <label asp-for="HorarioDesejado">
                            Horário desejado
                        </label>

                        <input asp-for="HorarioDesejado" type="time" />
                    </div>

                </div>

            </div>
        }


        <!-- RETIRO -->
        @if (Model.MissaoNome == "Retiro Quaresmal")
        {
            <div class="admin-form-secao">

                <h3> <i class="fa-solid fa-cross"></i>Dados do Retiro</h3>

                <div class="admin-form-grid">

                    <div class="admin-form-campo">
                        <label asp-for="Comunidade">
                            Comunidade / Paroquia
                        </label>

                        <input asp-for="Comunidade" />
                    </div>


                    <div class="admin-form-campo">

                        <label asp-for="JaParticipou">
                            Já participou?
                        </label>

                        <select asp-for="JaParticipou">
                            <option value="">Selecione</option>
                            <option value="Sim">Sim</option>
                            <option value="Não">Não</option>
                        </select>

                    </div>

                </div>

            </div>
        }

        <!-- SEMANA -->
        @if (Model.MissaoNome == "Semana da Juventude")
        {
            <div class="admin-form-secao">

                <h3> <i class="fa-solid fa-users"></i>Dados da Semana da Juventude</h3>

                <div class="admin-form-grid">

                    <div class="admin-form-campo">
                        <label asp-for="Grupo">Grupo/Pastoral</label>
                        <input asp-for="Grupo" />
                    </div>

                    <div class="admin-form-campo">
                        <label asp-for="Turno">Turno</label>
                        <select asp-for="Turno">
                            <option value="">Selecione</option>
                            <option value="Manhã">Manhã</option>
                            <option value="Tarde">Tarde</option>
                            <option value="Noite">Noite</option>
                        </select>
                    </div>

                </div>

            </div>
        }


        <!-- TERÇO -->
        @if (Model.MissaoNome == "Terço da Juventude")
        {
            <div class="admin-form-secao">

                <h3><i class="fa-solid fa-hands-praying"></i>Dados do Terço</h3>

                <div class="admin-form-grid">

                    <div class="admin-form-campo">
                        <label asp-for="Participacao">
                            Participação
                        </label>

                        <select asp-for="Participacao">
                            <option value="">Selecione</option>
                            <option value="Participante">Participante</option>
                            <option value="Leitor">Leitor</option>
                            <option value="Músico">Músico</option>
                            <option value="Equipe de apoio">Equipe de apoio</option>
                        </select>
                    </div>

                    <div class="admin-form-campo">
                        <label asp-for="DiaDisponivel">
                            Dia disponível
                        </label>

                        <select asp-for="DiaDisponivel">
                            <option value="">Selecione</option>
                            <option value="Segunda-feira">Segunda-feira</option>
                            <option value="Terça-feira">Terça-feira</option>
                            <option value="Quarta-feira">Quarta-feira</option>
                            <option value="Quinta-feira">Quinta-feira</option>
                            <option value="Sexta-feira">Sexta-feira</option>
                            <option value="Sábado">Sábado</option>
                            <option value="Domingo">Domingo</option>
                        </select>
                    </div>

                </div>

            </div>
        }


        <!-- SEGUE-ME -->
        @if (Model.MissaoNome == "Segue-me Jovem")
        {
            <div class="admin-form-secao">

                <h3>
                    <i class="fa-solid fa-people-group"></i>
                    Dados do Segue-me Jovem
                </h3>

                <div class="admin-form-grid">

                    <div class="admin-form-campo admin-form-full">

                        <label asp-for="Comunidade">
                            Comunidade / Paróquia
                        </label>

                        <input asp-for="Comunidade" />

                    </div>

                </div>

            </div>
        }


        <!-- OBSERVAÇÃO -->
        <div class="admin-form-secao">

            <h3>
                <i class="fa-solid fa-note-sticky"></i>
                Observação
            </h3>

            <div class="admin-form-campo">

                <label asp-for="Observacao">
                    Observação
                </label>

                <textarea asp-for="Observacao" rows="5">
                </textarea>

                <span asp-validation-for="Observacao" class="login-validacao">
                </span>

            </div>

        </div>

        <!-- BOTÕES -->
        <div class="admin-form-acoes">

            <a asp-controller="Admin" asp-action="DetalhesInscricao" asp-route-id="@Model.Id" class="admin-btn-cancelar">
                <i class="fa-solid fa-xmark"></i> Cancelar
            </a>

            <button type="submit" class="admin-btn-salvar">
                <i class="fa-solid fa-floppy-disk"></i> Salvar alterações
            </button>

        </div>

    </form>

</div>