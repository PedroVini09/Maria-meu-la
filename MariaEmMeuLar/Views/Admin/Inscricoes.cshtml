@model IEnumerable<MariaEmMeuLar.Models.Inscricao>

@{
    ViewData["Title"] = "Inscrições";
}

<div class="admin-page-title">
    <h2>Inscrições</h2>
    <p>Lista de inscrições realizadas.</p>
</div>
   
    <div class="inscricoes-toolbar">

        <!--Filtro-->
        <form asp-controller="Admin" asp-action="Inscricoes" method="get" class="inscricoes-filtro-form">
            <div class="inscricoes-filtro-campo">
                <label for="missaoId">Filtrar por Missão</label>
                <select id="missaoId" name="missaoId" asp-items="ViewBag.Missoes" onchange="this.form.submit()">
                    <option value="">Todas as Missões</option>
                </select>
            </div>
        </form>

        <!--Botões-->
        <div class="inscricoes-toolbar-acoes">
            <a asp-controller="Admin" asp-action="NovaInscricao" class="inscricoes-btn-inserir">
                <i class="fa-solid fa-plus"></i>
                Inserir
            </a>

            <button type="button" id="btnEditarInscricao" class="admin-btn-editar-topo"disabled>
                <i class="fa-solid fa-pen"></i>
                Editar

            </button>

            <button type="button" id="btnExcluirInscricao" class="admin-btn-excluir-topo" disabled>
                <i class="fa-solid fa-trash"></i>
                Excluir
            </button>
        </div>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="col-selecao"></th>
                    <th>Nome</th>
                    <th>Missão</th>
                    <th>Telefone</th>
                    <th>Data de Inscrição</th>
                    <th>Status</th>
                    <th>Detalhes</th>
                </tr>
            </thead>
            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="admin-table-empty">Nenhuma inscrição encontrada.</td>
                    </tr>
                }
                else
                {
                    @foreach (var inscricao in Model)
                    {
                        <tr class="inscricao-linha">
                            <!--Seleção-->
                            <td class="col-selecao">
                                <input type="radio" name="inscricaoSelecionada" value="@inscricao.Id" class="inscricao-radio" />
                            </td>
                            <td>
                                <strong>@inscricao.Nome</strong><br />
                            </td>
                            <td>@(inscricao.Missao?.Nome ?? "Missão não especificada")</td>
                            <td>@inscricao.Telefone</td>
                            <td>@inscricao.DataInscricao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="admin-status">@inscricao.Status</span></td>
                            <td>
                                    <a asp-controller="Admin" asp-action="DetalhesInscricao" asp-route-id="@inscricao.Id"
                                       class="admin-btn-detalhes">
                                        Detalhes
                                    </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <!--FORMULÁRIO OCULTO DE EXCLUSÃO-->

    <form id="formExcluirInscricao" asp-controller="Admin" asp-action="ExcluirInscricao" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="excluirInscricaoId" />
    </form>

    @section Scripts {
        <script >

            const radios = document.querySelectorAll('.inscricao-radio');

            const btnEditar = document.getElementById('btnEditarInscricao');
            const btnExcluir = document.getElementById('btnExcluirInscricao');

            let selectedInscricaoId = null;

            radios.forEach(radio => {
                radio.addEventListener('change', () => {
                    selectedInscricaoId = radio.value;

                    //habilitar botões de editar e excluir
                    btnEditar.disabled = false;
                    btnExcluir.disabled = false;

                    //remove seleção visual anterior
                    document.querySelectorAll('.inscricao-linha').forEach(row => {
                                row.classList.remove('selecionada');
                    });

                    //destaca linha atual selecionada
                    radio.closest('.inscricao-linha').classList.add('selecionada');
                });
            });

            //Botão Editar
            btnEditar.addEventListener('click', () => {
                if (!selectedInscricaoId){
                            return;
                } 

                    window.location.href = `/Admin/EditarInscricao/${selectedInscricaoId}`;
            });

            //Botão Excluir
            btnExcluir.addEventListener('click', () => {
                if (!selectedInscricaoId) {
                    return;
                }

                const confirmacao = confirm("Tem certeza que deseja excluir esta inscrição? Esta ação não pode ser desfeita.");
                if (!confirmacao) {
                    return;
                }
                        document.getElementById('excluirInscricaoId').value = selectedInscricaoId;
                        document.getElementById('formExcluirInscricao').submit();
            });
        </script>
    }
