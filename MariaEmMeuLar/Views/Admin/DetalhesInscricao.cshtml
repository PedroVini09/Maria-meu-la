@model MariaEmMeuLar.Models.Inscricao

@{
    ViewData["Title"] = "Detalhes da Inscrição";
}

<div class="admin-page-title">
    <h2>Detalhes da Inscrição</h2>
    <p>Informações completas da inscrição realizada.</p>
</div>

<div class="admin-detalhes-card">

    <div class="admin-detalhes-header">

        <div>
            <span class="admin-detalhes-missao">
                @Model.Missao?.Nome
            </span>

            <h3>@Model.Nome</h3>
        </div>

        <span class="admin-status">
            @Model.Status
        </span>

    </div>


    <div class="admin-detalhes-secao">

        <h4>
            <i class="fa-solid fa-user"></i>
            Dados do participante
        </h4>

        <div class="admin-detalhes-grid">

            <div class="admin-detalhes-item">
                <span>Nome</span>
                <strong>@Model.Nome</strong>
            </div>

            <div class="admin-detalhes-item">
                <span>Telefone</span>
                <strong>@Model.Telefone</strong>
            </div>

            @if (Model.Idade.HasValue)
            {
                <div class="admin-detalhes-item">
                    <span>Idade</span>
                    <strong>@Model.Idade anos</strong>
                </div>
            }

            <div class="admin-detalhes-item">
                <span>Data da inscrição</span>
                <strong>
                    @Model.DataInscricao.ToString("dd/MM/yyyy HH:mm")
                </strong>
            </div>

        </div>

    </div>


    @* MARIA EM MEU LAR *@
    @if (Model.Missao?.Nome == "Maria em Meu Lar")
    {
        <div class="admin-detalhes-secao">

            <h4>Dados da Maria em Meu Lar</h4>

            <div class="admin-detalhes-grid">

                <div class="admin-detalhes-item admin-detalhes-item-largo">
                    <span>Endereço</span>
                    <strong>@Model.Endereco</strong>
                </div>

                <div class="admin-detalhes-item">
                    <span>Data desejada</span>
                    <strong>
                        @(Model.DataDesejada?.ToString("dd/MM/yyyy") ?? "-")
                    </strong>
                </div>

                <div class="admin-detalhes-item">
                    <span>Horário desejado</span>
                    <strong>
                        @(Model.HorarioDesejado?.ToString(@"hh\:mm") ?? "-")
                    </strong>
                </div>

            </div>

        </div>
    }


    @* RETIRO *@
    @if (Model.Missao?.Nome == "Retiro Quaresmal")
    {
        <div class="admin-detalhes-secao">

            <h4>Dados do Retiro Quaresmal</h4>

            <div class="admin-detalhes-grid">

                <div class="admin-detalhes-item">
                    <span>Comunidade / Paróquia</span>
                    <strong>@Model.Comunidade</strong>
                </div>

                <div class="admin-detalhes-item">
                    <span>Já participou?</span>
                    <strong>@Model.JaParticipou</strong>
                </div>

            </div>

        </div>
    }


    @* SEMANA *@
    @if (Model.Missao?.Nome == "Semana da Juventude")
    {
        <div class="admin-detalhes-secao">

            <h4>Dados da Semana da Juventude</h4>

            <div class="admin-detalhes-grid">

                <div class="admin-detalhes-item">
                    <span>Grupo / Pastoral</span>
                    <strong>@Model.Grupo</strong>
                </div>

                <div class="admin-detalhes-item">
                    <span>Turno</span>
                    <strong>@Model.Turno</strong>
                </div>

            </div>

        </div>
    }


    @* TERÇO *@
    @if (Model.Missao?.Nome == "Terço da Juventude")
    {
        <div class="admin-detalhes-secao">

            <h4>Dados do Terço da Juventude</h4>

            <div class="admin-detalhes-grid">

                <div class="admin-detalhes-item">
                    <span>Participação</span>
                    <strong>@Model.Participacao</strong>
                </div>

                <div class="admin-detalhes-item">
                    <span>Dia disponível</span>
                    <strong>@Model.DiaDisponivel</strong>
                </div>

            </div>

        </div>
    }


    @* SEGUE-ME *@
    @if (Model.Missao?.Nome == "Segue-me Jovem")
    {
        <div class="admin-detalhes-secao">

            <h4>Dados do Segue-me Jovem</h4>

            <div class="admin-detalhes-grid">

                <div class="admin-detalhes-item">
                    <span>Comunidade / Paróquia</span>
                    <strong>@Model.Comunidade</strong>
                </div>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Model.Observacao))
    {
        <div class="admin-detalhes-secao">

            <h4>Observação</h4>

            <div class="admin-observacao">
                @Model.Observacao
            </div>

        </div>
    }


    <div class="admin-detalhes-acoes">

        <a asp-action="Inscricoes" class="admin-btn-voltar">

            <i class="fa-solid fa-arrow-left"></i>
            Voltar

        </a>

        <a asp-action="EditarInscricao" asp-route-id="@Model.Id" class="admin-btn-editar-detalhes">

            <i class="fa-solid fa-pen"></i>
            Editar inscrição

        </a>

    </div>

</div>