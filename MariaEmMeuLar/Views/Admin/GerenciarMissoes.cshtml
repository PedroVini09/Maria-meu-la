@model IEnumerable<MariaEmMeuLar.Models.Missao>

@{
    ViewData["Title"] = "Gerenciar Missões";
}

<div class="admin-page-title">
    <div>
        <h2>Gerenciar Missões</h2>
        <p>Cadastre, edite e gerencie as missões do sistema.</p>
    </div>
</div>


<div class="missoes-toolbar">

    <a asp-controller="Admin" asp-action="NovaMissao" class="inscricoes-btn-inserir">

        <i class="fa-solid fa-plus"></i>
        Nova Missão

    </a>


    <button type="button" id="btnEditarMissao" class="admin-btn-editar-topo" disabled>

        <i class="fa-solid fa-pen"></i>
        Editar

    </button>


    <button type="button" id="btnExcluirMissao" class="admin-btn-excluir" disabled>
        <i class="fa-solid fa-trash"></i>
        Excluir / Desativar
    </button>

</div>


<div class="admin-table-container">

    <table class="admin-table">

        <thead>
            <tr>
                <th class="col-selecao"></th>
                <th>Missão</th>
                <th>Status</th>
                <th>Inscrições</th>
            </tr>
        </thead>


        <tbody>

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="admin-table-empty">

                        Nenhuma missão cadastrada.

                    </td>
                </tr>
            }
            else
            {
                @foreach (var missao in Model)
                {
                    <tr class="missao-linha">

                        <td class="col-selecao">

                            <input type="radio" name="missaoSelecionada" value="@missao.Id" data-nome="@missao.Nome"
                                    class="missao-radio" />

                        </td>


                        <td>
                            <strong>@missao.Nome</strong>
                        </td>


                        <td>

                            @if (missao.Ativa)
                            {
                                <span class="missao-status ativa">
                                    Ativa
                                </span>
                            }
                            else
                            {
                                <span class="missao-status inativa">
                                    Inativa
                                </span>
                            }

                        </td>


                        <td>

                            @if (missao.InscricoesAbertas)
                            {
                                <span class="status-inscricao aberta">
                                    Inscrições abertas
                                </span>
                            }
                            else
                            {
                                <span class="status-inscricao fechada">
                                    Inscrições fechadas
                                </span>
                            }

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

    <form asp-controller="Admin" asp-action="ExcluirOuDesativarMissao" method="post" id="formExcluirMissao"
          style="display: none;">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" id="missaoIdExcluir" />

    </form>

</div>


@section Scripts
{
    <script>

        const radiosMissao =
            document.querySelectorAll(".missao-radio");

        const btnEditarMissao =
            document.getElementById("btnEditarMissao");

        const btnExcluirMissao =
            document.getElementById("btnExcluirMissao");

        const formExcluirMissao =
            document.getElementById("formExcluirMissao");

        const missaoIdExcluir =
            document.getElementById("missaoIdExcluir");


        let missaoSelecionadaId = null;
        let missaoSelecionadaNome = "";


        // ==========================================
        // SELEÇÃO DA MISSÃO
        // ==========================================

        radiosMissao.forEach(radio => {

            radio.addEventListener("change", () => {

                missaoSelecionadaId = radio.value;

                missaoSelecionadaNome =
                    radio.dataset.nome;


                // Habilita os botões
                btnEditarMissao.disabled = false;
                btnExcluirMissao.disabled = false;


                // Guarda o ID no formulário de exclusão
                missaoIdExcluir.value =
                    missaoSelecionadaId;


                // Remove destaque das outras linhas
                document
                    .querySelectorAll(".missao-linha")
                    .forEach(linha => {

                        linha.classList.remove(
                            "selecionada"
                        );

                    });


                // Destaca a linha selecionada
                radio
                    .closest(".missao-linha")
                    .classList.add(
                        "selecionada"
                    );

            });

        });


        // ==========================================
        // EDITAR MISSÃO
        // ==========================================

        btnEditarMissao.addEventListener(
            "click",
            () => {

                if (!missaoSelecionadaId) {
                    return;
                }


                window.location.href =
                    `/Admin/EditarMissao/${missaoSelecionadaId}`;

            }
        );


        // ==========================================
        // EXCLUIR / DESATIVAR MISSÃO
        // ==========================================

        btnExcluirMissao.addEventListener(
            "click",
            () => {

                if (!missaoSelecionadaId) {
                    return;
                }


                const confirmar =
                    window.confirm(
                        `Deseja realmente excluir ou desativar a missão "${missaoSelecionadaNome}"?\n\n` +
                        `Se a missão possuir inscrições, ela será apenas desativada.\n` +
                        `Se não possuir inscrições, ela será excluída permanentemente.`
                    );


                if (!confirmar) {
                    return;
                }


                formExcluirMissao.submit();

            }
        );

    </script>
}