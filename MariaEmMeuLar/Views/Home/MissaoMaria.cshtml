@{
    ViewData["Title"] = "Maria em Meu Lar";
}

<section class="missao-page missao-maria">
    <section class="missao-hero">
        <div class="missao-hero-texto">
            <span class="missao-label">Missão</span>
            
            <h1>
                Maria em<br/>
                <strong>Meu Lar</strong>
            </h1>
            
            <p>
                Uma missão de fé, oração e acolhimento que leva a presença materna<br/>
                de Maria aos lares, ajudando as famílias a se aproximarem de Jesus <br/>
                Cristo e fortalecerem sua caminhada cristã.
            </p>
            
            <div class="missao-divider">
                <span></span>
                <i class="fa-solid fa-diamond"></i>
                <span></span>
            </div>
            
            <a asp-action="Home" asp-controller="Inscricao" class="missao-btn">
                <i class="fa-solid fa-pen-to-square"></i>
                Fazer Inscrição
            </a>
        </div>
        <div class="missao-hero-imagem">
            <img src="~/img/inscricao/inscricao_maria.png" alt="Maria em meu lar"/>
        </div>
    </section>
</section>